{
    "AWSTemplateFormatVersion": "2010-09-09",
    "Description": "The AWS CloudFormation template creates all the required resources for creating a AWS  job in the account",
    "Resources": {
        "ConsoleUser": {
            "Type": "AWS::IAM::User",
            "DependsOn": "SourceKey",
            "Properties": {
                "Path": "/",
                "LoginProfile": {
                    "Password": "aC:!eW?m<7U3CFs5",
                    "PasswordResetRequired": "false"
                },
                "ManagedPolicyArns": ["arn:aws:iam::aws:policy/AWSBackupFullAccess","arn:aws:iam::aws:policy/AWSCloudTrail_ReadOnlyAccess","arn:aws:iam::aws:policy/AmazonEC2ReadOnlyAccess"],
                "Policies": [{
                    "PolicyName": "backupuserpolicy",
                    "PolicyDocument": {
                        "Version": "2012-10-17",
                        "Statement": [{
                                "Sid": "VisualEditor0",
                                "Effect": "Allow",
                                "Action": "iam:AttachRolePolicy",
                                "Resource": "*",
                                "Condition": {
                                    "ArnEquals": {
                                        "iam:PolicyARN": {
                                            "Fn::Sub": "arn:aws:iam::${AWS::AccountId}:policy/*backuppolicy*"
                                        }
                                    }
                                }
                            }, {
                                "Sid": "VisualEditor1",
                                "Effect": "Allow",
                                "Action": ["iam:GetPolicyVersion", "iam:CreateServiceSpecificCredential", "iam:ListRoleTags", "iam:UntagRole", "iam:TagRole", "iam:DeleteRolePermissionsBoundary", "iam:AddRoleToInstanceProfile", "iam:ListInstanceProfilesForRole", "iam:DetachRolePolicy", "iam:DeleteRolePolicy", "iam:ListAttachedRolePolicies", "iam:DetachGroupPolicy", "iam:ListPolicyTags", "iam:ListRolePolicies", "iam:CreatePolicyVersion", "iam:ListPolicies", "iam:GetRole", "iam:DeleteAccountPasswordPolicy", "iam:GetInstanceProfile", "iam:GetPolicy", "iam:ListRoles", "iam:UpdateRoleDescription", "iam:ListInstanceProfiles", "iam:TagPolicy", "iam:ListPolicyVersions", "iam:UntagPolicy", "iam:UpdateRole", "iam:GetGroupPolicy", "iam:DeleteGroupPolicy", "iam:GetRolePolicy", "iam:DeletePolicyVersion", "iam:SetDefaultPolicyVersion", "iam:PutRolePolicy"],
                                "Resource": "*"
                            }, {
                                "Sid": "VisualEditor2",
                                "Effect": "Allow",
                                "Action": "iam:PassRole",
                                "Resource": {
                                    "Fn::Sub": "arn:aws:iam::${AWS::AccountId}:role/*backuprole*"
                                }
                            }, {
                                "Effect": "Deny",
                                "Action": "iam:PassRole",
                                "Resource": ["arn:aws:iam::*:role/*AwsBackup*", "arn:aws:iam::*:role/*AWSBackup*"],
                                "Condition": {
                                    "StringLike": {
                                        "iam:PassedToService": "backup.amazonaws.com"
                                    }
                                }
                            },
                            {
                                "Effect": "Allow",
                                "Action": "kms:*",
                                "Resource": {"Fn::GetAtt": ["SourceKey", "Arn"]}
                            }
                            {
                                "Effect": "Deny",
                                "Action": ["iam:DetachRolePolicy", "iam:DeleteRolePolicy"],
                                "Resource": "*",
                                "Condition": {
                                    "ArnEquals": {
                                        "iam:PolicyARN": {
                                            "Fn::Sub": "arn:aws:iam::${AWS::AccountId}:policy/*KMSPolicyNotChangable*"
                                        }
                                    }
                                }
                            }
                        ]
                    }
                }]
            }
        },
        "SourceKey": {
            "Type": "AWS::KMS::Key",
            "Properties": {
                "KeyPolicy": {
                    "Version": "2012-10-17",
                    "Id": "SourceKey",
                    "Statement": [{
                            "Sid": "Allow access through Backup for all principals in the account that are authorized to use Backup Storage",
                            "Effect": "Allow",
                            "Principal": {
                                "AWS": "*"
                            },
                            "Action": ["kms:CreateGrant", "kms:Decrypt", "kms:GenerateDataKey*"],
                            "Resource": "*",
                            "Condition": {
                                "StringEquals": {
                                    "kms:CallerAccount": {
                                        "Fn::Sub": "${AWS::AccountId}"
                                    },
                                    "kms:ViaService": {
                                        "Fn::Sub": "backup.${AWS::Region}.amazonaws.com"
                                    }
                                }
                            }
                        }, {
                            "Sid": "Allow direct access to key metadata to the account",
                            "Effect": "Allow",
                            "Principal": {
                                "AWS": {
                                    "Fn::Sub": "arn:aws:iam::${AWS::AccountId}:root"
                                }
                            },
                            "Action": "kms:*",
                            "Resource": "*"
                        },
                        {
                            "Effect": "Deny",
                            "Principal": "*",
                            "Action": ["kms:CreateGrant", "kms:Decrypt", "kms:GenerateDataKey*"],
                            "Resource": "*",
                            "Condition": {
                                "StringLike": {
                                    "aws:PrincipalArn": [
                                        {"Fn::Sub": "arn:aws:iam::${AWS::AccountId}:assumed-role/*backuprole*"},
                                        {"Fn::Sub": "arn:aws:iam::${AWS::AccountId}:role/service-role/AWSBackupDefaultServiceRole"}
                                    ]
                                }
                            }
                        }

                    ]
                }
            }
        },
        "BackupEbs": {
            "Type": "AWS::EC2::Volume",
            "DependsOn": "SourceKey",
            "Properties": {
                "Size": "8",
                "Encrypted": "true",
                "AvailabilityZone": {
                    "Fn::Sub": "${AWS::Region}b"
                },
                "KmsKeyId": {
                    "Fn::GetAtt": ["SourceKey", "Arn"]
                },
                "Tags": [{
                    "Key": "Name",
                    "Value": "BackupEbs"
                }]
            }
        },
        "SourceBackupVault": {
            "Type": "AWS::Backup::BackupVault",
            "Properties": {
                "BackupVaultName": "SourceBackupVault3"
            }
        },
        "backuprole": {
            "Type": "AWS::IAM::Role",
            "Properties": {
                "AssumeRolePolicyDocument": {
                    "Version": "2012-10-17",
                    "Statement": [{
                        "Effect": "Allow",
                        "Principal": {
                            "Service": "backup.amazonaws.com"
                        },
                        "Action": "sts:AssumeRole"
                    }]
                }
            }
        },
        "backuppolicy": {
            "Type": "AWS::IAM::Policy",
            "DependsOn": "backuprole",
            "Properties": {
                "PolicyName": "backuppolicy",
                "PolicyDocument": {
                    "Version": "2012-10-17",
                    "Statement": [{
                            "Effect": "Allow",
                            "Action": ["ec2:CreateSnapshot", "ec2:DeleteSnapshot", "ec2:CreateTags"],
                            "Resource": ["arn:aws:ec2:*::snapshot/*", "arn:aws:ec2:*:*:volume/*"]
                        }, {
                            "Effect": "Allow",
                            "Action": ["ec2:DescribeVolumes", "ec2:DescribeSnapshots", "ec2:CopySnapshot", "ec2:DescribeTags"],
                            "Resource": "*"
                        }, {
                            "Action": ["tag:GetResources"],
                            "Resource": "*",
                            "Effect": "Allow"
                        },
                        {
                            "Sid": "DenyAccessToDefaultEBSKey",
                            "Action": ["kms:DescribeKey", "kms:Decrypt", "kms:Encrypt", "kms:GenerateDataKey", "kms:ReEncrypt*"],
                            "Effect": "Deny",
                            "Resource": {
                                "Fn::Sub": "arn:aws:kms:${AWS::Region}:${AWS::AccountId}:alias/aws/ebs"
                            }
                        }
                    ]
                },
                "Roles": [{
                    "Ref": "backuprole"
                }]
            }
        },
        "KMSPolicyNotChangable": {
            "Type": "AWS::IAM::Policy",
            "DependsOn": "backuprole",
            "Properties": {
                "PolicyName": "KMSPolicyNotChangable",
                "PolicyDocument": {
                    "Version": "2012-10-17",
                    "Statement": [{
                            "Action": ["kms:DescribeKey", "kms:Decrypt", "kms:Encrypt", "kms:GenerateDataKey", "kms:ReEncrypt*", "kms:CreateGrant"],
                            "Effect": "Allow",
                            "Resource": "*",
                            "Condition": {
                                "StringEquals": {
                                    "aws:RequestedRegion": ["us-east-1", "ap-south-1", "eu-west-1"]
                                }
                            }
                        },
                        {
                            "Sid": "DenyAccessToDefaultBackupKey",
                            "Action": ["kms:DescribeKey", "kms:Decrypt", "kms:Encrypt", "kms:GenerateDataKey", "kms:ReEncrypt*"],
                            "Effect": "Deny",
                            "Resource": {
                                "Fn::Sub": "arn:aws:kms:${AWS::Region}:${AWS::AccountId}:alias/aws/backup"
                            }
                        }

                    ]
                },
                "Roles": [{
                    "Ref": "backuprole"
                }]
            }
        }
    },
    "Outputs": {
        "ConsoleUserName": {
            "Description": "Console Login url for S3",
            "Value": {
                "Ref": "ConsoleUser"
            }
        },
        "ConsoleAccessURL": {
            "Description": "Console Login url for S3",
            "Value": {
                "Fn::Sub": "https://${AWS::AccountId}.signin.aws.amazon.com/console"
            }
        },
        "ConsolUserPassword": {
            "Description": "ConsolUser Password",
            "Value": "aC:!eW?m<7U3CFs5"
        },
        "BackupRole": {
            "Description": "Backup role",
            "Value": {
                "Ref": "backuprole"
            }
        },
        "BackupVault": {
            "Description": "BackupVault Name",
            "Value": {
                "Ref": "SourceBackupVault"
            }
        },
        "BackupEbs": {
            "Description": "EBS volume to be backed up",
            "Value": {
                "Ref": "BackupEbs"
            }
        },
        "KMSKey": {
            "Description": "KMS key of the EBS volume",
            "Value": {
                "Ref": "SourceKey"
            }
        }
    }
}